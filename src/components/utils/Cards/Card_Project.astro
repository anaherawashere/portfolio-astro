---
import ButtonExternalXS from '../Buttons/Button_ExternalXS.astro'
import PillsTech from '../Pills/Pills_Tech.astro'
import type { ProjectProps } from '../../../types/interfaces'

const { description, image, links, tech, title } = Astro.props as ProjectProps
---

<li
  class="group relative flex flex-col md:flex-row-reverse gap-x-6 py-5 lg:px-6 rounded-md z-10">
  <div
    class="-z-10 absolute w-[110%] lg:w-full h-full top-0 -inset-x-4 lg:left-0 rounded-md ease-in duration-100 group-hover:bg-purple group-hover:bg-opacity-10">
  </div>
  <div class="w-full lg:w-3/4 xs:mb-3">
    <h3
      class="mb-2 text-lg font-semibold text-heading group-hover:text-purple ease-in duration-100">
      <a
        href={links.filter((link) => link.name === 'website')[0].href}
        target="_blank"
        rel="noreferrer noopener"
        aria-label={`Visit ${title} (open in a new tab)`}>
        {title}
        <span
          class="group/link absolute w-[110%] lg:w-full h-full top-0 -inset-x-4 lg:left-0 rounded-md">
        </span>
        <span class="pl-1">
          <i
            aria-hidden="true"
            class="fa-solid fa-arrow-right -rotate-45 text-xs ease-in duration-100 group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
          ></i>
        </span>
      </a>
    </h3>
    <p class="mb-2 text-sm">
      {description}
    </p>
    <ul class="mb-4 flex flex-wrap gap-x-4 gap-y-3" aria-label="Related links">
      {
        links.length > 1 &&
          links.map((link) => {
            return (
              <ButtonExternalXS
                href={link.href}
                aria-label={`Vist ${link.name}`}
                name={link.name}
              />
            )
          })
      }
    </ul>
    <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
      {tech.map((el) => <PillsTech>{el}</PillsTech>)}
    </ul>
  </div>
  <div class="w-52 h-fit lg:w-1/4 shadow-xl overflow-hidden rounded-sm">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="object-contain w-full h-full"
    />
  </div>
</li>
